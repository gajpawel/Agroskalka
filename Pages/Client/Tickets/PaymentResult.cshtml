@page
@model Agroskalka.Pages.Client.Tickets.PaymentResultModel
@{
    ViewData["Title"] = Model.IsSuccess ? "Płatność zakończona" : "Płatność nieudana";
}

<div class="max-w-xl mx-auto px-4 mt-16">
    <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 text-center">
        @if (Model.IsSuccess)
        {
            <div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl font-bold">
                ✓
            </div>
            <h1 class="text-2xl font-extrabold text-slate-900">Dziękujemy za zakup!</h1>
            <p class="mt-2 text-sm text-slate-600">
                Twój bilet o kodzie <span class="font-mono font-bold text-slate-900">@Model.Ticket?.Code</span> został opłacony.
            </p>
        }
        else
        {
            <div class="w-16 h-16 bg-amber-100 text-amber-600 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl font-bold">
                !
            </div>
            <h1 class="text-2xl font-extrabold text-slate-900">Płatność nie została dokończona</h1>
            <p class="mt-2 text-sm text-slate-600">
                Bilet o kodzie <span class="font-mono font-bold text-slate-900">@Model.Ticket?.Code</span> został zapisany na Twoim koncie ze statusem nieopłaconym. Możesz ponowić płatność w panelu klienta.
            </p>
        }

        <div class="mt-8">
            <a asp-page="/Client" class="inline-block px-6 py-2.5 rounded-lg bg-blue-600 text-white font-bold hover:bg-blue-700 transition-colors">
                Przejdź do moich biletów
            </a>
        </div>
    </div>
</div>