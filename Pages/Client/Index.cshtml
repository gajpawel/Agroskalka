@page
@model Agroskalka.Pages.Client.IndexModel
@{
    ViewData["Title"] = "Panel Klienta";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-8 sm:mt-12">
    <div class="mb-10">
        <h1 class="text-3xl font-extrabold text-slate-900">Panel Klienta</h1>
        <p class="mt-2 text-lg text-slate-600">Wybierz, co chcesz zrobić.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        <!-- Karta: Kup bilet -->
        <a asp-page="/Client/Tickets/BuyTicket" class="block p-6 bg-white border border-slate-200 rounded-2xl shadow-sm hover:shadow-md hover:border-blue-500 transition-all group cursor-pointer">
            <div class="flex items-center space-x-4 mb-4">
                <div class="p-3 bg-blue-50 text-blue-600 rounded-xl group-hover:bg-blue-600 group-hover:text-white transition-colors">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                </div>
                <h2 class="text-xl font-bold text-slate-800">Kup Bilet</h2>
            </div>
            <p class="text-slate-600 text-sm leading-relaxed">
                Wybierz dzień wizyty, liczbę osób i kategorię biletu. Skorzystaj ze zniżki z Kartą Dużej Rodziny i zapłać online.
            </p>
        </a>

        <!-- Karta: Moje bilety -->
        <a asp-page="/Client/Tickets/Index" class="block p-6 bg-white border border-slate-200 rounded-2xl shadow-sm hover:shadow-md hover:border-emerald-500 transition-all group cursor-pointer">
            <div class="flex items-center space-x-4 mb-4">
                <div class="p-3 bg-emerald-50 text-emerald-600 rounded-xl group-hover:bg-emerald-600 group-hover:text-white transition-colors">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
                    </svg>
                </div>
                <h2 class="text-xl font-bold text-slate-800">Moje Bilety</h2>
            </div>
            <p class="text-slate-600 text-sm leading-relaxed">
                Przeglądaj aktywne i przeszłe bilety. Wyświetl bilet z kodem QR lub pobierz go w formie pliku PDF.
            </p>
        </a>

        <!-- Karta: Zarządzanie kontem -->
        <a asp-area="Identity" asp-page="/Account/Manage/Index" class="block p-6 bg-white border border-slate-200 rounded-2xl shadow-sm hover:shadow-md hover:border-orange-500 transition-all group cursor-pointer">
            <div class="flex items-center space-x-4 mb-4">
                <div class="p-3 bg-orange-50 text-orange-600 rounded-xl group-hover:bg-orange-600 group-hover:text-white transition-colors">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                </div>
                <h2 class="text-xl font-bold text-slate-800">Moje Konto</h2>
            </div>
            <p class="text-slate-600 text-sm leading-relaxed">
                Zmień swoje dane, hasło lub usuń konto.
            </p>
        </a>

    </div>
</div>