@using Microsoft.AspNetCore.Identity
@using Agroskalka.Models
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var appUser = await UserManager.GetUserAsync(User);
    
    var displayName = appUser?.Name ?? User.Identity?.Name;
    
    <div class="flex flex-col sm:flex-row sm:items-center space-y-2 sm:space-y-0 sm:space-x-4">
        <span class="text-slate-800 sm:text-slate-600 font-medium px-3 sm:px-0">
            Witaj, @displayName!
        </span>
        <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="m-0">
            <button type="submit" class="w-full sm:w-auto text-left sm:text-center px-3 py-3 sm:px-4 sm:py-2 rounded-md sm:rounded-lg text-base sm:text-sm font-medium text-red-600 sm:border sm:border-red-500 hover:bg-red-50 transition-colors">
                Wyloguj się
            </button>
        </form>
    </div>
}
else
{
    <div class="flex flex-col sm:flex-row space-y-3 sm:space-y-0 sm:space-x-4">
        <a asp-area="Identity" asp-page="/Account/Login" class="block text-center border border-purple-600 text-purple-600 hover:bg-purple-50 px-4 py-3 sm:py-2 rounded-lg text-base sm:text-sm font-medium transition-colors">
            Zaloguj się
        </a>
        <a asp-area="Identity" asp-page="/Account/Register" class="block text-center bg-purple-600 text-white hover:bg-purple-700 px-4 py-3 sm:py-2 rounded-lg text-base sm:text-sm font-medium shadow-sm transition-colors">
            Zarejestruj się
        </a>
    </div>
}