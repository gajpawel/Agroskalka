@page
@model Agroskalka.Pages.Admin.Tariffs.IndexModel
@{
    ViewData["Title"] = "Zarządzanie Cennikiem";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-8 sm:mt-12">
    <div class="sm:flex sm:items-center sm:justify-between mb-8">
        <div>
            <h1 class="text-3xl font-extrabold text-slate-900">Historia Cenników</h1>
            <p class="mt-2 text-sm text-slate-600">Zarządzaj cenami biletów. Pamiętaj, że nowe ceny dodajemy jako nowe wpisy, aby nie psuć historii starych transakcji.</p>
        </div>
        <div class="mt-4 sm:mt-0">
            <a asp-page="./Create" class="inline-flex items-center justify-center rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 transition-colors">
                + Ustal nowy cennik
            </a>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200 text-left">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-6 py-4 text-sm font-semibold text-slate-900">Status</th>
                        <th class="px-6 py-4 text-sm font-semibold text-slate-900">Ważny od</th>
                        <th class="px-6 py-4 text-sm font-semibold text-slate-900">Ważny do</th>
                        <th class="px-6 py-4 text-sm font-semibold text-slate-900">Dziecko</th>
                        <th class="px-6 py-4 text-sm font-semibold text-slate-900">Dorosły</th>
                        <th class="px-6 py-4 text-sm font-semibold text-slate-900">Senior</th>
                        <th class="px-6 py-4 text-sm font-semibold text-slate-900">Przejazd kolejką</th>
                        <th class="px-6 py-4 text-sm font-semibold text-slate-900 text-right">Akcje</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200">
                    @foreach (var item in Model.Tariffs)
                    {
                        // Sprawdzamy czy cennik obowiązuje dzisiaj
                        bool isCurrentlyActive = item.ValidFrom <= DateTime.UtcNow && item.ValidTo >= DateTime.UtcNow;

                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4">
                                @if (isCurrentlyActive)
                                {
                                    <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">Aktywny</span>
                                }
                                else if (item.ValidFrom > DateTime.UtcNow)
                                {
                                    <span class="inline-flex items-center rounded-full bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-600/20">Zaplanowany</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-1 text-xs font-medium text-slate-600 ring-1 ring-inset ring-slate-500/10">Archiwalny</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-sm text-slate-600 font-medium">@item.ValidFrom.ToString("dd.MM.yyyy")</td>
                            <td class="px-6 py-4 text-sm text-slate-600">@(item.ValidTo == DateTime.MaxValue ? "Bezterminowo" : item.ValidTo.ToString("dd.MM.yyyy"))</td>
                            <td class="px-6 py-4 text-sm text-slate-900 font-bold">@item.KidPrice.ToString("C")</td>
                            <td class="px-6 py-4 text-sm text-slate-900 font-bold">@item.AdultPrice.ToString("C")</td>
                            <td class="px-6 py-4 text-sm text-slate-900 font-bold">@item.SeniorPrice.ToString("C")</td>
                            <td class="px-6 py-4 text-sm text-slate-900 font-bold">@item.TrainPrice.ToString("C")</td>
                            <td class="px-6 py-4 text-right">
                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" onsubmit="return confirm('Czy na pewno chcesz usunąć ten cennik? Poprzedni cennik zostanie automatycznie wydłużony.');">
                                    <button type="submit" class="text-red-500 hover:text-red-700 font-medium text-sm transition-colors">
                                        Usuń
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>