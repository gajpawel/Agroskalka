@page
@model Agroskalka.Pages.Admin.Tariffs.CreateModel
@{
    ViewData["Title"] = "Dodaj Cennik";
}

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 mt-8 sm:mt-12">
    <div class="mb-8">
        <a asp-page="./Index" class="text-sm font-medium text-blue-600 hover:text-blue-500">&larr; Wróć do listy cenników</a>
        <h1 class="mt-4 text-3xl font-extrabold text-slate-900">Ustal nowy cennik</h1>
    </div>

    <form method="post" class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 space-y-8">
        
        <!-- Sekcja Daty -->
        <div>
            <h2 class="text-lg font-semibold text-slate-800 border-b border-slate-100 pb-2 mb-4">Wprowadzenie w życie</h2>
            <div>
                <label asp-for="Tariff.ValidFrom" class="block text-sm font-medium text-slate-700 mb-1">Obowiązuje od dnia</label>
                <input asp-for="Tariff.ValidFrom" type="date" class="block w-full max-w-md rounded-lg border-slate-300 py-2.5 px-3 border shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm outline-none" required />
                <p class="mt-1 text-xs text-slate-500">Poprzedni cennik automatycznie wygaśnie dzień wcześniej.</p>
            </div>
        </div>

        <!-- Sekcja Cen -->
        <div>
            <h2 class="text-lg font-semibold text-slate-800 border-b border-slate-100 pb-2 mb-4">Ceny biletów (zł)</h2>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                <div>
                    <label asp-for="Tariff.KidPrice" class="block text-sm font-medium text-slate-700 mb-1">Dziecko</label>
                    <input asp-for="Tariff.KidPrice" type="number" step="0.01" min="0" class="block w-full rounded-lg border-slate-300 py-2.5 px-3 border shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm outline-none" required />
                </div>
                <div>
                    <label asp-for="Tariff.AdultPrice" class="block text-sm font-medium text-slate-700 mb-1">Dorosły</label>
                    <input asp-for="Tariff.AdultPrice" type="number" step="0.01" min="0" class="block w-full rounded-lg border-slate-300 py-2.5 px-3 border shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm outline-none" required />
                </div>
                <div>
                    <label asp-for="Tariff.SeniorPrice" class="block text-sm font-medium text-slate-700 mb-1">Senior</label>
                    <input asp-for="Tariff.SeniorPrice" type="number" step="0.01" min="0" class="block w-full rounded-lg border-slate-300 py-2.5 px-3 border shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm outline-none" required />
                </div>
            </div>
        </div>

        <!-- Sekcja Zniżek -->
        <div>
            <h2 class="text-lg font-semibold text-slate-800 border-b border-slate-100 pb-2 mb-4">Zniżki i dodatki</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                    <label asp-for="Tariff.TrainPrice" class="block text-sm font-medium text-slate-700 mb-1">Przejazd kolejką (zł)</label>
                    <input asp-for="Tariff.TrainPrice" type="number" step="0.01" min="0" class="block w-full rounded-lg border-slate-300 py-2.5 px-3 border shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm outline-none" required />
                </div>
            </div>
        </div>

        <div class="pt-4 flex justify-end gap-3">
            <a asp-page="./Index" class="px-5 py-2.5 rounded-lg border border-slate-300 text-slate-700 font-medium hover:bg-slate-50 transition-colors">Anuluj</a>
            <button type="submit" class="px-6 py-2.5 rounded-lg bg-blue-600 text-white font-bold hover:bg-blue-700 shadow-sm transition-colors">Zapisz nowy cennik</button>
        </div>
    </form>
</div>