@page
@model Agroskalka.Pages.Admin.Tickets.CheckModel
@{
    ViewData["Title"] = "Weryfikacja biletów";
}

<!-- Zaciągamy bibliotekę do obsługi aparatu i kodów QR -->
<script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 mt-8 sm:mt-12">
    <h1 class="text-3xl font-extrabold text-slate-900 mb-8 text-center">Bramka: Sprawdzanie biletów</h1>

    <!-- 1. Formularz wpisywania kodu / skaner -->
    <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-slate-200 mb-8">
        
        <!-- Własny, ładny interfejs skanera (domyślnie ukryty) -->
        <div id="scanner-ui" class="hidden mb-8 bg-slate-50 p-4 sm:p-6 rounded-xl border border-slate-200">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-4">
                <div class="w-full sm:w-auto flex-1">
                    <label class="block text-sm font-medium text-slate-700 mb-1">Wybierz aparat:</label>
                    <select id="camera-select" class="block w-full rounded-lg border-slate-300 py-2 px-3 border shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm outline-none bg-white">
                        <option value="">Ładowanie kamer...</option>
                    </select>
                </div>
                <div class="flex gap-2 w-full sm:w-auto self-end">
                    <button type="button" id="start-btn" onclick="startScanning()" class="w-full sm:w-auto bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-2 px-4 rounded-lg shadow-sm transition-colors text-sm">
                        Uruchom kamerę
                    </button>
                    <button type="button" id="stop-btn" onclick="stopScanning()" class="hidden w-full sm:w-auto bg-red-600 hover:bg-red-700 text-white font-semibold py-2 px-4 rounded-lg shadow-sm transition-colors text-sm">
                        Zatrzymaj
                    </button>
                    <button type="button" onclick="closeScannerUI()" class="w-full sm:w-auto bg-slate-200 hover:bg-slate-300 text-slate-800 font-semibold py-2 px-4 rounded-lg transition-colors text-sm">
                        Zamknij
                    </button>
                </div>
            </div>

            <!-- Tutaj biblioteka wrzuci sam czysty obraz z kamery -->
            <div class="bg-black rounded-xl overflow-hidden shadow-inner w-full max-w-sm mx-auto relative">
                <div id="reader" class="w-full"></div>
            </div>
        </div>

        <form id="checkForm" method="post">
            <div class="flex items-center justify-between mb-2">
                <label asp-for="Code" class="block text-sm font-semibold text-slate-700">Wpisz kod lub użyj aparatu</label>
                <button type="button" onclick="initScanner()" id="startScanBtn" class="text-sm text-emerald-600 hover:text-emerald-700 font-bold flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd" /></svg>
                    Włącz skaner QR
                </button>
            </div>
            
            <div class="flex flex-col sm:flex-row gap-4">
                <input asp-for="Code" id="CodeInput" type="text" placeholder="np. ABC-123-XYZ" autofocus autocomplete="off"
                       class="block w-full rounded-xl border-slate-300 py-3.5 px-4 border shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-xl font-mono outline-none uppercase" />
                
                <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 px-8 rounded-xl shadow-sm transition-colors text-lg whitespace-nowrap">
                    Sprawdź bilet
                </button>
            </div>
        </form>
    </div>

    <!-- 2. Wielki komunikat zwrotny (Status) -->
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="p-6 rounded-2xl shadow-sm mb-8 border-2 
             @(Model.IsError ? (Model.IsAlreadyChecked ? "bg-amber-50 border-amber-300" : "bg-red-50 border-red-300") : "bg-emerald-50 border-emerald-400")">
            
            <h2 class="text-2xl sm:text-3xl font-black text-center 
                @(Model.IsError ? (Model.IsAlreadyChecked ? "text-amber-700" : "text-red-700") : "text-emerald-700")">
                @Model.StatusMessage
            </h2>
        </div>
    }

    <!-- 3. Wyświetlenie parametrów biletu -->
    @if (Model.ScannedTicket != null)
    {
        <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-slate-200">
            <h3 class="text-lg font-semibold text-slate-800 mb-6 border-b border-slate-100 pb-3">Szczegóły rezerwacji</h3>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                    <p class="text-sm text-slate-500">Data wejścia</p>
                    <p class="text-lg font-bold text-slate-900">@Model.ScannedTicket.Date.ToString("dd.MM.yyyy")</p>
                </div>
                <div>
                    <p class="text-sm text-slate-500">Status płatności</p>
                    @if(Model.ScannedTicket.IsPaid)
                    {
                        <span class="inline-flex items-center rounded-full bg-green-100 px-3 py-1 mt-1 text-sm font-semibold text-green-800">
                            Opłacony (@Model.ScannedTicket.Price.ToString("C"))
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center rounded-full bg-red-100 px-3 py-1 mt-1 text-sm font-semibold text-red-800">
                            Nieopłacony (@Model.ScannedTicket.Price.ToString("C"))
                        </span>
                    }
                </div>
                <div class="sm:col-span-2">
                    <p class="text-sm text-slate-500">Kupujący</p>
                    <p class="font-medium text-slate-900">@(Model.ScannedTicket.User?.Email ?? "Konto usunięte / brak danych")</p>
                </div>
            </div>

            <div class="mt-6 pt-6 border-t border-slate-100">
                <p class="text-sm text-slate-500 mb-3">Liczba osób do wpuszczenia:</p>
                <div class="flex flex-wrap gap-3">
                    @if(Model.ScannedTicket.AdultsNumber > 0) { <span class="bg-slate-100 border border-slate-200 px-4 py-2 rounded-xl text-slate-800 font-bold">Dorośli: @Model.ScannedTicket.AdultsNumber</span> }
                    @if(Model.ScannedTicket.KidsNumber > 0) { <span class="bg-slate-100 border border-slate-200 px-4 py-2 rounded-xl text-slate-800 font-bold">Dzieci: @Model.ScannedTicket.KidsNumber</span> }
                    @if(Model.ScannedTicket.SeniorsNumber > 0) { <span class="bg-slate-100 border border-slate-200 px-4 py-2 rounded-xl text-slate-800 font-bold">Seniorzy: @Model.ScannedTicket.SeniorsNumber</span> }
                    @if(Model.ScannedTicket.BabiesNumber > 0) { <span class="bg-slate-100 border border-slate-200 px-4 py-2 rounded-xl text-slate-800 font-bold">Maluchy: @Model.ScannedTicket.BabiesNumber</span> }
                </div>
            </div>
        </div>
    }
</div>

<!-- Skrypt sterujący skanerem -->
<script>
    let html5QrCode;

    // 1. Pobiera listę kamer i buduje ładnego dropdowna
    async function initScanner() {
        document.getElementById('scanner-ui').classList.remove('hidden');
        document.getElementById('startScanBtn').classList.add('hidden');

        try {
            const cameras = await Html5Qrcode.getCameras();
            if (cameras && cameras.length > 0) {
                const select = document.getElementById('camera-select');
                select.innerHTML = ''; // czyszczenie placeholder'a
                
                cameras.forEach(camera => {
                    const option = document.createElement('option');
                    option.value = camera.id;
                    // Jeśli system nie udostępni nazwy, nazywamy je Kamera 1, 2 itd.
                    option.text = camera.label || `Kamera ${select.length + 1}`;
                    select.appendChild(option);
                });
            } else {
                alert("Nie znaleziono żadnej kamery w urządzeniu.");
            }
        } catch (err) {
            console.error("Błąd pobierania kamer:", err);
            alert("Brak dostępu do kamery. Upewnij się, że zaakceptowałeś uprawnienia.");
        }
    }

    // 2. Uruchamia wybraną kamerę
    function startScanning() {
        const cameraId = document.getElementById('camera-select').value;
        if (!cameraId) return;

        if (!html5QrCode) {
            html5QrCode = new Html5Qrcode("reader");
        }

        // Zmiana przycisków
        document.getElementById('start-btn').classList.add('hidden');
        document.getElementById('stop-btn').classList.remove('hidden');
        document.getElementById('camera-select').disabled = true;

        html5QrCode.start(
            cameraId,
            { 
                fps: 10, 
                qrbox: { width: 250, height: 250 },
                aspectRatio: 1.0 
            },
            (decodedText) => {
                // Sukces: stopujemy kamerę, wpisujemy kod i wysyłamy formularz
                stopScanning();
                document.getElementById('CodeInput').value = decodedText;
                document.getElementById('checkForm').submit();
            },
            (errorMessage) => {
                // Ignorujemy błędy odczytu pojedynczych klatek
            }
        ).catch(err => {
            console.error(err);
            alert("Nie udało się uruchomić wybranej kamery.");
            stopScanning();
        });
    }

    // 3. Zatrzymuje tylko obraz (skaner dalej jest widoczny)
    function stopScanning() {
        if (html5QrCode && html5QrCode.isScanning) {
            html5QrCode.stop().then(() => {
                document.getElementById('start-btn').classList.remove('hidden');
                document.getElementById('stop-btn').classList.add('hidden');
                document.getElementById('camera-select').disabled = false;
            }).catch(err => console.error(err));
        }
    }

    // 4. Całkowicie zamyka panel skanera
    function closeScannerUI() {
        stopScanning();
        document.getElementById('scanner-ui').classList.add('hidden');
        document.getElementById('startScanBtn').classList.remove('hidden');
    }
</script>

<style>
    /* Ukrycie niepotrzebnego baneru reklamowego biblioteki, który czasem się pojawia */
    #reader a { display: none !important; }
</style>

<style>
    /* Drobne poprawki estetyczne dla biblioteki skanera, żeby pasowała do Tailwinda */
    #reader { border: none !important; }
    #reader__dashboard_section_csr button {
        background-color: #059669 !important; /* emerald-600 */
        color: white !important;
        border: none !important;
        border-radius: 0.5rem !important;
        padding: 0.5rem 1rem !important;
        cursor: pointer;
        margin-top: 10px;
    }
    #reader__dashboard_section_csr select {
        padding: 0.25rem;
        border-radius: 0.25rem;
        color: #334155;
    }
    #reader video {
        border-radius: 0.75rem;
        object-fit: cover;
    }
</style>