
@page
@model LoginWith2faModel
@{
    ViewData["Title"] = "Weryfikacja dwuetapowa";
    Layout = "/Pages/Shared/_Layout.cshtml";
}

<div class="max-w-lg mx-auto px-4 sm:px-6 mt-12 mb-20">

    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-8">

        <div class="flex justify-center mb-6">
            <div class="w-16 h-16 rounded-2xl bg-purple-100 flex items-center justify-center">
                <svg class="w-8 h-8 text-purple-600"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     viewBox="0 0 24 24">
                    <rect x="5" y="10" width="14" height="11" rx="2" />
                    <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                    <path d="M12 14v3" />
                </svg>
            </div>
        </div>

        <div class="text-center mb-8">
            <span class="inline-flex items-center rounded-full bg-purple-50 px-3 py-1 text-xs font-semibold text-purple-700 mb-4">
                Krok 2 z 2
            </span>

            <h1 class="text-3xl font-extrabold text-slate-900">
                Potwierdź swoją tożsamość
            </h1>

            <p class="mt-3 text-sm leading-relaxed text-slate-600">
                Twoje konto jest chronione uwierzytelnianiem
                dwuskładnikowym.
                Otwórz aplikację Google Authenticator lub
                Microsoft Authenticator i wpisz aktualny kod.
            </p>
        </div>

        <form method="post"
              asp-route-returnUrl="@Model.ReturnUrl"
              class="space-y-6">

            <input asp-for="RememberMe" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-sm text-red-600 text-center"
                 role="alert"></div>

            <div>
                <label asp-for="Input.TwoFactorCode"
                       class="block text-sm font-semibold text-slate-700 mb-3 text-center">
                    6-cyfrowy kod weryfikacyjny
                </label>

                <input asp-for="Input.TwoFactorCode"
                       type="text"
                       inputmode="numeric"
                       autocomplete="one-time-code"
                       maxlength="7"
                       autofocus
                       placeholder="000000"
                       class="block w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-4 text-center text-3xl font-bold tracking-[0.4em] text-slate-900 shadow-sm outline-none transition-all focus:border-purple-500 focus:bg-white focus:ring-4 focus:ring-purple-100" />

                <span asp-validation-for="Input.TwoFactorCode"
                      class="block text-sm text-red-600 text-center mt-2"></span>

                <p class="text-center text-xs text-slate-500 mt-3">
                    Kod zmienia się automatycznie co 30 sekund.
                </p>
            </div>

            <div class="flex items-center justify-center gap-3">
                <input asp-for="Input.RememberMachine"
                       class="h-4 w-4 rounded border-slate-300 text-purple-600 focus:ring-purple-500" />

                <label asp-for="Input.RememberMachine"
                       class="text-sm text-slate-600">
                    Zapamiętaj to urządzenie
                </label>
            </div>

            <button type="submit"
                    class="w-full flex items-center justify-center rounded-xl bg-purple-600 px-6 py-3.5 text-base font-bold text-white shadow-sm transition-all hover:bg-purple-700 focus:outline-none focus:ring-4 focus:ring-purple-200">
                Potwierdź i zaloguj się
            </button>
        </form>

        <div class="mt-8 pt-6 border-t border-slate-100 text-center">
            <p class="text-sm text-slate-500 mb-2">
                Nie masz dostępu do telefonu?
            </p>

            <a asp-page="./LoginWithRecoveryCode"
               asp-route-returnUrl="@Model.ReturnUrl"
               class="text-sm font-semibold text-purple-600 hover:text-purple-700 hover:underline">
                Zaloguj się kodem odzyskiwania
            </a>
        </div>
    </div>

    <div class="mt-6 text-center">
        <p class="text-xs text-slate-400">
            Twoje bezpieczeństwo jest dla nas ważne.
            Agroskalka chroni Twoje konto dodatkowym etapem weryfikacji.
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
