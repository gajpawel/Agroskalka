@page
@model LoginModel

@{
    ViewData["Title"] = "Logowanie";
}

<div class="max-w-5xl mx-auto mt-12 px-4 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-extrabold text-center text-slate-900 mb-10">@ViewData["Title"]</h1>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
        
        <!-- Lewa kolumna: Tradycyjne logowanie -->
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200">
            <section>
                <form id="account" method="post" class="space-y-6">
                    <h2 class="text-xl font-semibold text-slate-800 text-center mb-6">Zaloguj się swoim kontem</h2>
                    
                    <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 p-3 rounded-lg" role="alert"></div>
                    
                    <div>
                        <label asp-for="Input.Email" class="block text-sm font-medium text-slate-700 mb-1">Email</label>
                        <input asp-for="Input.Email" class="block w-full rounded-lg border-slate-300 py-2.5 px-3 border shadow-sm focus:border-purple-500 focus:ring-purple-500 sm:text-sm outline-none transition-colors" autocomplete="username" aria-required="true" placeholder="jan.kowalski@example.com" />
                        <span asp-validation-for="Input.Email" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    
                    <div>
                        <label asp-for="Input.Password" class="block text-sm font-medium text-slate-700 mb-1">Hasło</label>
                        <input asp-for="Input.Password" class="block w-full rounded-lg border-slate-300 py-2.5 px-3 border shadow-sm focus:border-purple-500 focus:ring-purple-500 sm:text-sm outline-none transition-colors" autocomplete="current-password" aria-required="true" placeholder="••••••••" />
                        <span asp-validation-for="Input.Password" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    
                    <div class="flex items-center">
                        <input asp-for="Input.RememberMe" class="h-4 w-4 rounded border-slate-300 text-purple-600 focus:ring-purple-500 cursor-pointer" />
                        <label asp-for="Input.RememberMe" class="ml-2 block text-sm text-slate-700 cursor-pointer">
                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                        </label>
                    </div>
                    
                    <div>
                        <button id="login-submit" type="submit" class="w-full flex justify-center py-3 px-4 border border-transparent rounded-xl shadow-sm text-base font-bold text-white bg-purple-600 hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 transition-colors">
                            Zaloguj się
                        </button>
                    </div>
                    
                    <div class="flex flex-col space-y-3 pt-4 border-t border-slate-100 text-sm text-center">
                        <a id="forgot-password" asp-page="./ForgotPassword" class="font-medium text-purple-600 hover:text-purple-500 transition-colors">Zapomniałeś hasła?</a>
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="font-medium text-purple-600 hover:text-purple-500 transition-colors">Zarejestruj nowe konto</a>
                        <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="font-medium text-slate-500 hover:text-slate-700 transition-colors">Wyślij ponownie link aktywacyjny</a>
                    </div>
                </form>
            </section>
        </div>

        <!-- Prawa kolumna: Logowanie zewnętrzne -->
        <div class="bg-slate-50 p-8 rounded-2xl border border-slate-200 flex flex-col justify-center text-center">
            <section>
                <h3 class="text-lg font-semibold text-slate-800 mb-4">Zaloguj się przez inny serwis</h3>
                <hr class="border-slate-200 mb-6" />
                @{
                    if ((Model.ExternalLogins?.Count ?? 0) == 0)
                    {
                        <div class="text-slate-500 text-sm leading-relaxed">
                            <p class="mb-4">
                                Nie skonfigurowano żadnych zewnętrznych usług uwierzytelniania.
                            </p>
                            <p>
                                Przeczytaj <a href="https://go.microsoft.com/fwlink/?LinkID=532715" class="text-purple-600 hover:underline font-medium">ten artykuł</a>, 
                                aby dowiedzieć się, jak skonfigurować aplikację ASP.NET do obsługi logowania zewnętrznego (np. Google, Facebook).
                            </p>
                        </div>
                    }
                    else
                    {
                        <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                            <div class="flex flex-col space-y-3">
                                @foreach (var provider in Model.ExternalLogins!)
                                {
                                    <button type="submit" class="w-full flex justify-center py-3 px-4 border-2 border-slate-200 rounded-xl shadow-sm text-base font-medium text-slate-700 bg-white hover:bg-slate-50 hover:border-slate-300 transition-colors" name="provider" value="@provider.Name" title="Zaloguj się używając konta @provider.DisplayName">
                                        Zaloguj przez @provider.DisplayName
                                    </button>
                                }
                            </div>
                        </form>
                    }
                }
            </section>
        </div>
        
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}