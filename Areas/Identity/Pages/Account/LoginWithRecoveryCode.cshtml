@page
@model LoginWithRecoveryCodeModel

@{
    Layout = "/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Logowanie kodem odzyskiwania";
}

<div class="max-w-lg mx-auto px-4 py-10 sm:py-14">

    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8">

        <!-- Nagłówek -->
        <div class="text-center mb-7">

            <div class="w-14 h-14 mx-auto bg-purple-100 rounded-2xl flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="28" height="28"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="text-purple-600">
                    <circle cx="8" cy="15" r="4" />
                    <path d="m10.85 12.15 8.3-8.3a2.12 2.12 0 0 1 3 3l-8.3 8.3"/>
                    <path d="m18 5 1 1"/>
                </svg>
            </div>

            <h1 class="text-2xl font-extrabold text-slate-900">
                Logowanie awaryjne
            </h1>

            <p class="text-sm text-slate-500 mt-2">
                Użyj jednego z zapisanych kodów odzyskiwania.
            </p>
        </div>

        <!-- Informacja -->
        <div class="rounded-xl bg-blue-50 border border-blue-100 p-4 mb-6">
            <p class="text-sm text-blue-800 leading-relaxed">
                Jeśli nie masz dostępu do aplikacji Authenticator,
                możesz zalogować się przy użyciu kodu zapasowego.
                Każdy kod można wykorzystać tylko raz.
            </p>
        </div>

        <!-- Formularz -->
        <form method="post"
              asp-route-returnUrl="@Model.ReturnUrl"
              class="space-y-5">

            <div asp-validation-summary="ModelOnly"
                 class="text-sm text-red-600 bg-red-50 rounded-lg p-3 empty:hidden"
                 role="alert"></div>

            <div>
                <label asp-for="Input.RecoveryCode"
                       class="block text-sm font-semibold text-slate-700 mb-2">
                    Kod odzyskiwania
                </label>

                <input asp-for="Input.RecoveryCode"
                       autocomplete="off"
                       autocapitalize="off"
                       spellcheck="false"
                       placeholder="Wpisz kod zapasowy"
                       class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-center font-mono text-base tracking-wider text-slate-900 outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-200 transition" />

                <span asp-validation-for="Input.RecoveryCode"
                      class="block text-sm text-red-600 mt-2"></span>
            </div>

            <button type="submit"
                    class="w-full rounded-xl bg-purple-600 px-5 py-3 font-semibold text-white shadow-sm hover:bg-purple-700 transition">
                Zaloguj się kodem odzyskiwania
            </button>

        </form>

        <div class="mt-6 pt-5 border-t border-slate-100 text-center">

            <a asp-page="./LoginWith2fa"
               asp-route-returnUrl="@Model.ReturnUrl"
               class="text-sm font-semibold text-purple-600 hover:text-purple-700 transition">
                Wróć do logowania kodem z aplikacji
            </a>

        </div>

    </div>

    <p class="text-center text-xs text-slate-400 mt-5">
        AgroSkalka — bezpieczne logowanie
    </p>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}