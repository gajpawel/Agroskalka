@page
@model Agroskalka.Areas.Identity.Pages.Account.Manage.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Moje konto";
    ViewData["ActivePage"] = "Index";
}
<div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200">
    <h2 class="text-xl font-semibold text-slate-800 mb-6">Dane osobowe</h2>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        var isError = Model.StatusMessage.StartsWith("Błąd");
            <div class="mb-6 text-sm p-3 rounded-lg @(isError ? "text-red-600 bg-red-50" : "text-emerald-700 bg-emerald-50")" role="alert">
            @Model.StatusMessage
            </div>
    }

    <form id="profile-form" method="post" class="space-y-6">
        <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 p-3 rounded-lg" role="alert"></div>

        <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Email</label>
            <input value="@Model.Username" disabled
                   class="block w-full rounded-lg border-slate-300 bg-slate-50 text-slate-500 py-2.5 px-3 border shadow-sm sm:text-sm" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
                <label asp-for="Input.Name" class="block text-sm font-medium text-slate-700 mb-1"></label>
                <input asp-for="Input.Name" autocomplete="given-name"
                       class="block w-full rounded-lg border-slate-300 py-2.5 px-3 border shadow-sm focus:border-purple-500 focus:ring-purple-500 sm:text-sm outline-none transition-colors" />
                <span asp-validation-for="Input.Name" class="text-xs text-red-500 mt-1 block"></span>
            </div>
            <div>
                <label asp-for="Input.Surname" class="block text-sm font-medium text-slate-700 mb-1"></label>
                <input asp-for="Input.Surname" autocomplete="family-name"
                       class="block w-full rounded-lg border-slate-300 py-2.5 px-3 border shadow-sm focus:border-purple-500 focus:ring-purple-500 sm:text-sm outline-none transition-colors" />
                <span asp-validation-for="Input.Surname" class="text-xs text-red-500 mt-1 block"></span>
            </div>
        </div>

        <button type="submit"
                class="w-full flex justify-center py-3 px-4 border border-transparent rounded-xl shadow-sm text-base font-bold text-white bg-purple-600 hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 transition-colors">
            Zapisz zmiany
        </button>
    </form>
</div>

@section Scripts {
        <partial name="_ValidationScriptsPartial" />
}