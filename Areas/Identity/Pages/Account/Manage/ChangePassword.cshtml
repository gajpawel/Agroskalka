@page
@model ChangePasswordModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Zmiana hasła";
    ViewData["ActivePage"] = "ChangePassword";
}


<div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200">
    <h2 class="text-xl font-semibold text-slate-800 mb-6">@ViewData["Title"]</h2>
    <partial name="_StatusMessage" for="StatusMessage" />

    <form id="change-password-form" method="post" class="space-y-6">
        <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 p-3 rounded-lg" role="alert"></div>

        <div>
            <label asp-for="Input.OldPassword" class="block text-sm font-medium text-slate-700 mb-1">Obecne hasło</label>
            <input asp-for="Input.OldPassword" autocomplete="current-password" aria-required="true" placeholder="••••••••"
                   class="block w-full rounded-lg border-slate-300 py-2.5 px-3 border shadow-sm focus:border-purple-500 focus:ring-purple-500 sm:text-sm outline-none transition-colors" />
            <span asp-validation-for="Input.OldPassword" class="text-xs text-red-500 mt-1 block"></span>
        </div>
        <div>
            <label asp-for="Input.NewPassword" class="block text-sm font-medium text-slate-700 mb-1">Nowe hasło</label>
            <input asp-for="Input.NewPassword" autocomplete="new-password" aria-required="true" placeholder="••••••••"
                   class="block w-full rounded-lg border-slate-300 py-2.5 px-3 border shadow-sm focus:border-purple-500 focus:ring-purple-500 sm:text-sm outline-none transition-colors" />
            <span asp-validation-for="Input.NewPassword" class="text-xs text-red-500 mt-1 block"></span>
        </div>
        <div>
            <label asp-for="Input.ConfirmPassword" class="block text-sm font-medium text-slate-700 mb-1">Potwierdź nowe hasło</label>
            <input asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" placeholder="••••••••"
                   class="block w-full rounded-lg border-slate-300 py-2.5 px-3 border shadow-sm focus:border-purple-500 focus:ring-purple-500 sm:text-sm outline-none transition-colors" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-xs text-red-500 mt-1 block"></span>
        </div>

        <button type="submit"
                class="w-full flex justify-center py-3 px-4 border border-transparent rounded-xl shadow-sm text-base font-bold text-white bg-purple-600 hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 transition-colors">
            Zmień hasło
        </button>
    </form>
</div>

@section Scripts {
        <partial name="_ValidationScriptsPartial" />
}