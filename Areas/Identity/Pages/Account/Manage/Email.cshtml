@page
@model EmailModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Zmiana e-maila";
    ViewData["ActivePage"] = "Email";
}

<div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200">
    <h2 class="text-xl font-semibold text-slate-800 mb-6">@ViewData["Title"]</h2>
    <partial name="_StatusMessage" for="StatusMessage" />

    <form id="email-form" method="post" class="space-y-6">
        <div asp-validation-summary="ModelOnly" class="[&.validation-summary-valid]:hidden text-sm text-red-600 bg-red-50 p-3 rounded-lg" role="alert"></div>

        <div>
            <label asp-for="Email" class="block text-sm font-medium text-slate-700 mb-1">Obecny e-mail</label>
            <input asp-for="Email" disabled
                   class="block w-full rounded-lg border-slate-300 bg-slate-50 text-slate-500 py-2.5 px-3 border shadow-sm sm:text-sm" />
            @* Potwierdzanie przez e-mail (wyłączone):
            @if (Model.IsEmailConfirmed)
            {
                <span class="text-emerald-600 font-bold" title="Potwierdzony">✓</span>
            }
            else
            {
                <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail"
                        class="mt-2 text-sm text-purple-600 hover:underline font-medium">
                    Wyślij e-mail weryfikacyjny
                </button>
            }
            *@
        </div>

        <div>
            <label asp-for="Input.NewEmail" class="block text-sm font-medium text-slate-700 mb-1">Nowy e-mail</label>
            <input asp-for="Input.NewEmail" autocomplete="email" aria-required="true"
                   class="block w-full rounded-lg border-slate-300 py-2.5 px-3 border shadow-sm focus:border-purple-500 focus:ring-purple-500 sm:text-sm outline-none transition-colors" />
            <span asp-validation-for="Input.NewEmail" class="text-xs text-red-500 mt-1 block"></span>
        </div>

        <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail"
                class="w-full flex justify-center py-3 px-4 border border-transparent rounded-xl shadow-sm text-base font-bold text-white bg-purple-600 hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 transition-colors">
            Zmień e-mail
        </button>
    </form>
</div>

@section Scripts {
        <partial name="_ValidationScriptsPartial" />
}