@{
    var active = ViewContext.ViewData["ActivePage"] as string ?? "";
    string Tab(string page) => page == active
        ? "px-4 py-2 rounded-lg text-sm font-semibold bg-purple-600 text-white"
        : "px-4 py-2 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-100";
}

@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var isKeycloakUser = User.HasClaim("auth_provider", "Keycloak");
    var keycloakAuthority = (Configuration["OIDC_AUTHORITY"] ?? Environment.GetEnvironmentVariable("OIDC_AUTHORITY"))?.TrimEnd('/');
    var keycloakAccountUrl = string.IsNullOrEmpty(keycloakAuthority) ? null : $"{keycloakAuthority}/account";
}

<nav class="flex flex-wrap gap-2 mb-6">
    <a class="@Tab("Index")" asp-page="./Index">Profil</a>

    @if (!isKeycloakUser)
    {
        <a class="@Tab("Email")" asp-page="./Email">E-mail</a>
        <a class="@Tab("ChangePassword")" asp-page="./ChangePassword">Hasło</a>
        <a class="@Tab("TwoFactorAuthentication")" asp-page="./TwoFactorAuthentication">Uwierzytelnianie 2FA</a>
    }
    else if (!string.IsNullOrEmpty(keycloakAccountUrl))
    {
        <a class="@Tab("KeycloakAccount")" href="@keycloakAccountUrl" target="_blank" rel="noopener noreferrer">
            Bezpieczeństwo i konto (Keycloak) ↗
        </a>
    }

    <a class="@Tab("PersonalData")" asp-page="./PersonalData">Dane i usuwanie konta</a>
</nav>