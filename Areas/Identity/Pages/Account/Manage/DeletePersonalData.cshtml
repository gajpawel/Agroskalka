@page
@model DeletePersonalDataModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Usuwanie konta";
    ViewData["ActivePage"] = "PersonalData";
}

<div class="bg-white p-8 rounded-2xl shadow-sm border border-red-200">
    <h2 class="text-xl font-semibold text-slate-800 mb-6">@ViewData["Title"]</h2>

    <div class="mb-6 text-sm text-red-700 bg-red-50 p-4 rounded-lg" role="alert">
        <strong>Usunięcie konta jest trwałe i nie można go cofnąć.</strong>
    </div>

    <form id="delete-user" method="post" class="space-y-6">
        <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 p-3 rounded-lg" role="alert"></div>

        @if (Model.RequirePassword)
        {
                <div>
                    <label asp-for="Input.Password" class="block text-sm font-medium text-slate-700 mb-1">Hasło</label>
                    <input asp-for="Input.Password" autocomplete="current-password" aria-required="true" placeholder="••••••••"
                           class="block w-full rounded-lg border-slate-300 py-2.5 px-3 border shadow-sm focus:border-red-500 focus:ring-red-500 sm:text-sm outline-none transition-colors" />
                    <span asp-validation-for="Input.Password" class="text-xs text-red-500 mt-1 block"></span>
                </div>
        }

        <button type="submit"
                class="w-full flex justify-center py-3 px-4 border border-transparent rounded-xl shadow-sm text-base font-bold text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors">
            Usuń dane i zamknij konto
        </button>
    </form>
</div>

@section Scripts {
        <partial name="_ValidationScriptsPartial" />
}