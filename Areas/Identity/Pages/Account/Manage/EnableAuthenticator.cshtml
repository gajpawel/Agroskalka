
@page
@model EnableAuthenticatorModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Konfiguracja uwierzytelniania 2FA";
    ViewData["ActivePage"] = "TwoFactorAuthentication";
}

<div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8">

    <div class="mb-8">
        <h2 class="text-2xl font-bold text-slate-900">
            Zabezpiecz swoje konto
        </h2>
        <p class="mt-2 text-slate-600">
            Włącz uwierzytelnianie dwuskładnikowe, aby chronić
            swoje konto przed nieautoryzowanym dostępem.
        </p>
    </div>

    <div class="space-y-8">

        <div>
            <div class="flex items-center gap-3 mb-3">
                <span class="flex items-center justify-center w-9 h-9 rounded-full bg-purple-100 text-purple-700 font-bold">
                    1
                </span>
                <h3 class="text-lg font-semibold text-slate-900">
                    Przygotuj aplikację Authenticator
                </h3>
            </div>

            <p class="text-slate-600 ml-12">
                Otwórz Google Authenticator lub Microsoft Authenticator
                na telefonie i wybierz opcję dodania nowego konta.
            </p>
        </div>

        <div>
            <div class="flex items-center gap-3 mb-4">
                <span class="flex items-center justify-center w-9 h-9 rounded-full bg-purple-100 text-purple-700 font-bold">
                    2
                </span>
                <h3 class="text-lg font-semibold text-slate-900">
                    Zeskanuj kod QR
                </h3>
            </div>

            <div class="ml-0 sm:ml-12 grid grid-cols-1 md:grid-cols-2 gap-6">

                <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6 flex flex-col items-center justify-center">
                    <div class="bg-white rounded-xl p-4 border border-slate-200">
                        <div id="qrCode"></div>
                    </div>

                    <p class="text-sm text-slate-500 mt-4 text-center">
                        Zeskanuj kod aparatem w aplikacji Authenticator
                    </p>
                </div>

                <div class="flex flex-col justify-center">
                    <p class="text-sm font-semibold text-slate-800 mb-2">
                        Nie możesz zeskanować kodu?
                    </p>

                    <p class="text-sm text-slate-600 mb-4">
                        Wybierz w aplikacji opcję ręcznego wpisania
                        klucza konfiguracji.
                    </p>

                    <div class="bg-purple-50 border border-purple-200 rounded-xl p-4">
                        <p class="text-xs text-purple-700 font-semibold mb-2">
                            Twój klucz konfiguracji
                        </p>

                        <code class="block text-sm font-mono font-semibold text-purple-900 break-all select-all">
                            @Model.SharedKey
                        </code>
                    </div>

                    <p class="text-xs text-slate-500 mt-3">
                        Zachowaj ten klucz w tajemnicy.
                        Nie udostępniaj go innym osobom.
                    </p>
                </div>
            </div>
        </div>

        <div id="qrCodeData" data-url="@Model.AuthenticatorUri" hidden></div>

        <div>
            <div class="flex items-center gap-3 mb-4">
                <span class="flex items-center justify-center w-9 h-9 rounded-full bg-purple-100 text-purple-700 font-bold">
                    3
                </span>
                <h3 class="text-lg font-semibold text-slate-900">
                    Potwierdź konfigurację
                </h3>
            </div>

            <form id="send-code" method="post" class="ml-0 sm:ml-12 space-y-5">

                <div asp-validation-summary="ModelOnly"
                     class="text-sm text-red-600"
                     role="alert"></div>

                <div>
                    <label asp-for="Input.Code"
                           class="block text-sm font-medium text-slate-700 mb-2">
                        Kod z aplikacji Authenticator
                    </label>

                    <input asp-for="Input.Code"
                           type="text"
                           inputmode="numeric"
                           autocomplete="one-time-code"
                           maxlength="7"
                           placeholder="000000"
                           class="block w-full max-w-xs rounded-xl border border-slate-300 bg-white px-4 py-3 text-center text-2xl font-bold tracking-widest text-slate-900 shadow-sm outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-200" />

                    <span asp-validation-for="Input.Code"
                          class="block mt-2 text-sm text-red-600"></span>

                    <p class="text-xs text-slate-500 mt-2">
                        Wpisz aktualny 6-cyfrowy kod wyświetlany na telefonie.
                    </p>
                </div>

                <div class="flex flex-col sm:flex-row gap-3">
                    <button type="submit"
                            class="inline-flex items-center justify-center rounded-xl bg-purple-600 px-6 py-3 text-sm font-bold text-white shadow-sm transition-colors hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-purple-400 focus:ring-offset-2">
                        Aktywuj weryfikację 2FA
                    </button>

                    <a asp-page="./TwoFactorAuthentication"
                       class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-6 py-3 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50">
                        Anuluj
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="~/lib/qrcode.min.js" asp-append-version="true"></script>

    <script>
        (function () {
            const qrContainer = document.getElementById("qrCode");
            const qrData = document.getElementById("qrCodeData");
            const uri = qrData?.dataset.url;

            if (!uri || typeof QRCode === "undefined") {
                qrContainer.textContent = "Nie udało się wygenerować kodu QR.";
                return;
            }

            new QRCode(qrContainer, {
                text: uri,
                width: 200,
                height: 200,
                colorDark: "#0f172a",
                colorLight: "#ffffff",
                correctLevel: QRCode.CorrectLevel.H
            });
        })();
    </script>
}
